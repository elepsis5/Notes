Свойства:
	const FILTERS_TYPES (array), //конфиг фильтров. из него берется список применяемых фильтров и их типы
	filters (array), //хранилище данных фильтров 
	meta (array), //хранилище данных пагинации и сортировки
	query (\Illuminate\Database\Eloquent\Builder) //собранный запрос с учетом пришедших фильтров

